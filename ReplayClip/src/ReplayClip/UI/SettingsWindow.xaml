<Window x:Class="ReplayClip.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ReplayClip.UI"
        Title="ReplayClip — Ajustes" Width="520" SizeToContent="Height"
        Icon="/ReplayClip;component/Assets/logo-zorro.png"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Retro.Face}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Aliased"
        FontFamily="Microsoft Sans Serif" FontSize="11">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReplayClip;component/UI/Retro95Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- Marco de ventana clásico en relieve -->
    <Border BorderBrush="{StaticResource Retro.Light}" BorderThickness="1,1,0,0">
        <Border BorderBrush="{StaticResource Retro.DarkShadow}" BorderThickness="0,0,1,1">
            <Border BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="1,1,0,0">
                <Border BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="0,0,1,1" Padding="2">
                    <DockPanel>

                        <!-- Barra de título: se arrastra para mover la ventana -->
                        <Grid DockPanel.Dock="Top" Height="18" Background="{StaticResource Retro.TitleBar}"
                              MouseLeftButtonDown="OnTitleBarMouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                                <!-- Logo pixel-art (escalado sin suavizado para que los píxeles queden nítidos) -->
                                <Image Source="/ReplayClip;component/Assets/logo-zorro.png" Width="16" Height="16" Margin="0,0,4,0"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <TextBlock Text="ReplayClip — Ajustes" Foreground="{StaticResource Retro.OnPrimary}" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0">
                                <Button Style="{StaticResource Retro.TitleButton}" Content="0" Click="OnMinimizeClick" ToolTip="Minimizar" />
                                <Button Style="{StaticResource Retro.TitleButton}" Content="r" Click="OnCloseClick" Margin="2,0,0,0" ToolTip="Cerrar" />
                            </StackPanel>
                        </Grid>

                        <!-- Barra de estado hundida -->
                        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="1,1,0,0">
                            <Border BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="0,0,1,1" Padding="4,2">
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                            </Border>
                        </Border>

                        <StackPanel Margin="8,8,8,0">
                            <GroupBox Header="Repetición y calidad" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Duración del búfer:" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="15" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding ReplaySeconds}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ReplaySeconds, StringFormat={}{0} s}" Margin="8,0,0,0" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Text="Bitrate de video:" VerticalAlignment="Center" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding BitrateMbps}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BitrateMbps, StringFormat={}{0} Mbps}" Margin="8,0,0,0" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2" Text="Fotogramas por segundo:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" ItemsSource="{Binding FpsChoices}"
                                              SelectedValuePath="Value" SelectedValue="{Binding FramesPerSecond}" />

                                    <TextBlock Grid.Row="3" Text="Resolución máxima:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2" ItemsSource="{Binding HeightChoices}"
                                              SelectedValuePath="Value" SelectedValue="{Binding MaxOutputHeight}" />

                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="{Binding MemoryEstimate}" Margin="0,6,0,0" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Fuente de captura" Margin="0,0,0,8">
                                <StackPanel>
                                    <ComboBox Margin="0,2" ItemsSource="{Binding ModeChoices}" SelectedValuePath="Value" SelectedValue="{Binding CaptureMode}" />
                                    <ComboBox Margin="0,2" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"
                                              Visibility="{Binding IsMonitorMode, Converter={StaticResource BoolToVisibility}}" />
                                    <CheckBox Margin="0,4" Content="Capturar el monitor sin borde amarillo (Desktop Duplication)"
                                              IsChecked="{Binding UseDesktopDuplication}"
                                              Visibility="{Binding IsMonitorMode, Converter={StaticResource BoolToVisibility}}" />
                                    <DockPanel Visibility="{Binding IsWindowMode, Converter={StaticResource BoolToVisibility}}">
                                        <Button DockPanel.Dock="Right" Content="Actualizar" Margin="6,2,0,2" Click="OnRefreshClick" />
                                        <ComboBox Margin="0,2" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" />
                                    </DockPanel>
                                    <DockPanel Visibility="{Binding IsProcessMode, Converter={StaticResource BoolToVisibility}}">
                                        <Button DockPanel.Dock="Right" Content="Actualizar" Margin="6,2,0,2" Click="OnRefreshClick" />
                                        <ComboBox Margin="0,2" IsEditable="True" ItemsSource="{Binding Processes}"
                                                  Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Nombre del proceso sin .exe, p. ej. League of Legends" />
                                    </DockPanel>
                                    <CheckBox Margin="0,4" Content="Grabar el cursor (Windows 10 2004 o superior)" IsChecked="{Binding CaptureCursor}" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Al capturar una ventana, Windows 10 dibuja un borde amarillo a su alrededor (obligatorio en el sistema; no sale en el video). La captura de monitor completo no lo muestra." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Audio" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox Margin="0,3" Content="Audio del sistema" IsChecked="{Binding CaptureSystemAudio}" />
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="Volumen del sistema:" VerticalAlignment="Center" Width="140" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SystemGainPercent, StringFormat={}{0} %}" Margin="8,0,0,0" VerticalAlignment="Center" Width="50" />
                                        <Slider Minimum="100" Maximum="800" TickFrequency="25" IsSnapToTickEnabled="True" Value="{Binding SystemGainPercent}"
                                                IsEnabled="{Binding CaptureSystemAudio}"
                                                ToolTip="Amplifica el audio del juego en los clips (100 % = sin cambio). Se aplica a la pista 2 y a la mezcla." />
                                    </DockPanel>
                                    <CheckBox x:Name="MicCheck" Margin="0,3" Content="Micrófono (pistas: 1 mezcla, 2 sistema, 3 micrófono)"
                                              IsChecked="{Binding CaptureMicrophone}" />
                                    <ComboBox Margin="0,2" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                                              IsEnabled="{Binding IsChecked, ElementName=MicCheck}" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Atajos y archivos" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Guardar repetición:" VerticalAlignment="Center" />
                                    <ui:HotkeyBox Grid.Column="1" GestureText="{Binding SaveHotkey}" Margin="0,2" />
                                    <TextBlock Grid.Row="1" Text="Grabar / detener:" VerticalAlignment="Center" />
                                    <ui:HotkeyBox Grid.Row="1" Grid.Column="1" GestureText="{Binding RecordHotkey}" Margin="0,2" />
                                    <TextBlock Grid.Row="2" Text="Carpeta de salida:" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OutputFolder}" Margin="0,2" />
                                    <Button Grid.Row="2" Grid.Column="2" Content="Examinar..." Margin="6,2,0,2" Click="OnBrowseClick" />
                                    <CheckBox Grid.Row="3" Grid.ColumnSpan="3" Margin="0,4" Content="Iniciar con Windows" IsChecked="{Binding StartWithWindows}" />
                                    <CheckBox Grid.Row="4" Grid.ColumnSpan="3" Margin="0,3" IsChecked="{Binding PlaySounds}"
                                              Content="Sonido al guardar un clip y al iniciar o detener la grabación"
                                              ToolTip="El sonido sale por los altavoces, así que también queda en el audio del sistema de los clips siguientes." />
                                    <CheckBox Grid.Row="5" Grid.ColumnSpan="3" Margin="0,3" IsChecked="{Binding NameClipsByGame}"
                                              Content="Empezar el nombre del clip con el juego detectado (LOL_Clip_..., TWD_Clip_...)"
                                              ToolTip="Para juegos que no se reconocen, agrega GameAliases en settings.json: nombre del proceso sin .exe, y la sigla." />
                                </Grid>
                            </GroupBox>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                <Button Content="Abrir registro" Margin="0,0,6,0" Click="OnOpenLogClick" />
                                <Button Content="Cancelar" Margin="0,0,6,0" IsCancel="True" Click="OnCancelClick" />
                                <Button Content="Guardar" IsDefault="True" Click="OnSaveClick" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
