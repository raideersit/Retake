<Window x:Class="ReplayClip.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ReplayClip.UI"
        Title="ReplayClip — Ajustes" Width="560" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <GroupBox Header="Repetición y calidad">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Text="Duración del búfer" />
                <Slider Grid.Column="1" Minimum="15" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding ReplaySeconds}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding ReplaySeconds, StringFormat={}{0} s}" Margin="8,0,0,0" />

                <TextBlock Grid.Row="1" Text="Bitrate de video" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding BitrateMbps}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BitrateMbps, StringFormat={}{0} Mbps}" Margin="8,0,0,0" />

                <TextBlock Grid.Row="2" Text="Fotogramas por segundo" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding FpsChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding FramesPerSecond}" />

                <TextBlock Grid.Row="3" Text="Resolución máxima" />
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding HeightChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding MaxOutputHeight}" />

                <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="{Binding MemoryEstimate}" Foreground="Gray" Margin="0,6,0,0" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Fuente de captura">
            <StackPanel>
                <ComboBox ItemsSource="{Binding ModeChoices}" SelectedValuePath="Value" SelectedValue="{Binding CaptureMode}" />
                <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"
                          Visibility="{Binding IsMonitorMode, Converter={StaticResource BoolToVisibility}}" />
                <DockPanel Visibility="{Binding IsWindowMode, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Content="Actualizar" Margin="6,3,0,3" Padding="8,0" Click="OnRefreshClick" />
                    <ComboBox x:Name="WindowCombo" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" />
                </DockPanel>
                <DockPanel Visibility="{Binding IsProcessMode, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Content="Actualizar" Margin="6,3,0,3" Padding="8,0" Click="OnRefreshClick" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding Processes}" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Nombre del proceso sin .exe, p. ej. League of Legends" />
                </DockPanel>
                <CheckBox Content="Grabar el cursor (Windows 10 2004 o superior)" IsChecked="{Binding CaptureCursor}" />
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0"
                           Text="En Windows 10 aparece un borde amarillo alrededor de lo capturado; es obligatorio en el sistema y no sale en el video." />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Audio">
            <StackPanel>
                <CheckBox Content="Audio del sistema" IsChecked="{Binding CaptureSystemAudio}" />
                <CheckBox x:Name="MicCheck" Content="Micrófono (pistas: 1 mezcla, 2 sistema, 3 micrófono)" IsChecked="{Binding CaptureMicrophone}" />
                <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                          IsEnabled="{Binding IsChecked, ElementName=MicCheck}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Atajos y archivos">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Guardar repetición" />
                <ui:HotkeyBox Grid.Column="1" GestureText="{Binding SaveHotkey}" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="Grabar / detener" />
                <ui:HotkeyBox Grid.Row="1" Grid.Column="1" GestureText="{Binding RecordHotkey}" Margin="0,3" />
                <TextBlock Grid.Row="2" Text="Carpeta de salida" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OutputFolder}" Margin="0,3" />
                <Button Grid.Row="2" Grid.Column="2" Content="Examinar…" Margin="6,3,0,3" Padding="8,0" Click="OnBrowseClick" />
                <CheckBox Grid.Row="3" Grid.ColumnSpan="3" Content="Iniciar con Windows" IsChecked="{Binding StartWithWindows}" />
            </Grid>
        </GroupBox>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="Gray" Margin="2,0,2,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abrir registro" Padding="12,4" Margin="0,0,8,0" Click="OnOpenLogClick" />
            <Button Content="Cancelar" Padding="12,4" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
            <Button Content="Guardar" Padding="16,4" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
