<!--
  Tema retro estilo Windows 95/98 con paleta Dark Indigo + lavanda: relieves 3D de 2 px, selección índigo y fuente
  MS Sans Serif sin suavizado. Solo lo usa la ventana de Ajustes, que existe únicamente mientras está
  abierta: cerrada, el tema no ocupa memoria ni CPU. Todo son plantillas estáticas, sin animaciones.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:ReplayClip.UI">

    <!-- Paleta Dark Indigo + lavanda. Los valores viven en RetroPalette.cs; aquí solo se crean los pinceles.
         Se mantienen las claves clásicas (Retro.Face, Retro.Shadow…) que usan las plantillas. -->
    <SolidColorBrush x:Key="Retro.Face" Color="{x:Static ui:RetroPalette.Surface}" />
    <SolidColorBrush x:Key="Retro.Highlight" Color="{x:Static ui:RetroPalette.BevelHighlight}" />
    <SolidColorBrush x:Key="Retro.Light" Color="{x:Static ui:RetroPalette.BevelLight}" />
    <SolidColorBrush x:Key="Retro.Shadow" Color="{x:Static ui:RetroPalette.BevelShadow}" />
    <SolidColorBrush x:Key="Retro.DarkShadow" Color="{x:Static ui:RetroPalette.BevelDarkShadow}" />
    <SolidColorBrush x:Key="Retro.Window" Color="{x:Static ui:RetroPalette.Background}" />
    <SolidColorBrush x:Key="Retro.Selection" Color="{x:Static ui:RetroPalette.Primary}" />
    <!-- Tokens semánticos -->
    <SolidColorBrush x:Key="Retro.Primary" Color="{x:Static ui:RetroPalette.Primary}" />
    <SolidColorBrush x:Key="Retro.OnPrimary" Color="{x:Static ui:RetroPalette.OnPrimary}" />
    <SolidColorBrush x:Key="Retro.Accent" Color="{x:Static ui:RetroPalette.Accent}" />
    <SolidColorBrush x:Key="Retro.Surface" Color="{x:Static ui:RetroPalette.Surface}" />
    <SolidColorBrush x:Key="Retro.Background" Color="{x:Static ui:RetroPalette.Background}" />
    <SolidColorBrush x:Key="Retro.Text" Color="{x:Static ui:RetroPalette.Text}" />
    <SolidColorBrush x:Key="Retro.TextDisabled" Color="{x:Static ui:RetroPalette.TextDisabled}" />
    <LinearGradientBrush x:Key="Retro.TitleBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{x:Static ui:RetroPalette.Primary}" Offset="0" />
        <GradientStop Color="{x:Static ui:RetroPalette.PrimaryGradientEnd}" Offset="1" />
    </LinearGradientBrush>
    <!-- Trama de puntos de las barras de desplazamiento clásicas -->
    <DrawingBrush x:Key="Retro.Dither" TileMode="Tile" Viewport="0,0,2,2" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Retro.Face}" Geometry="M0,0 H2 V2 H0 Z" />
                <GeometryDrawing Brush="{StaticResource Retro.Highlight}" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <FontFamily x:Key="Retro.Font">Microsoft Sans Serif, Tahoma</FontFamily>

    <!-- Rectángulo de foco punteado -->
    <Style x:Key="Retro.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="4" Stroke="{StaticResource Retro.Text}" StrokeThickness="1" StrokeDashArray="1 1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Texto -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Retro.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Retro.Text}" />
    </Style>

    <!-- Botón con relieve; hundido al pulsarlo; marco negro extra si es el predeterminado -->
    <Style x:Key="Retro.ButtonBase" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource Retro.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Retro.Text}" />
        <Setter Property="Background" Value="{StaticResource Retro.Face}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Retro.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="DefaultRing" BorderBrush="{StaticResource Retro.DarkShadow}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Border x:Name="O1" BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="1,1,0,0">
                            <Border x:Name="O2" BorderBrush="{StaticResource Retro.DarkShadow}" BorderThickness="0,0,1,1">
                                <Border x:Name="I1" BorderBrush="{StaticResource Retro.Light}" BorderThickness="1,1,0,0">
                                    <Border x:Name="I2" BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="0,0,1,1"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="O1" Property="BorderBrush" Value="{StaticResource Retro.DarkShadow}" />
                            <Setter TargetName="O2" Property="BorderBrush" Value="{StaticResource Retro.Highlight}" />
                            <Setter TargetName="I1" Property="BorderBrush" Value="{StaticResource Retro.Shadow}" />
                            <Setter TargetName="I2" Property="BorderBrush" Value="{StaticResource Retro.Light}" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Retro.Shadow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Retro.ButtonBase}">
        <Setter Property="MinWidth" Value="75" />
        <Setter Property="MinHeight" Value="23" />
        <Style.Triggers>
            <Trigger Property="IsDefaulted" Value="True">
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botones pequeños de la barra de título (glifos Marlett: 0 = minimizar, r = cerrar) -->
    <Style x:Key="Retro.TitleButton" TargetType="Button" BasedOn="{StaticResource Retro.ButtonBase}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Marlett" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Plantilla de campo hundido (cajas de texto, listas) -->
    <ControlTemplate x:Key="Retro.SunkenField" TargetType="TextBoxBase">
        <Border BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="1,1,0,0" SnapsToDevicePixels="True">
            <Border BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="0,0,1,1">
                <Border BorderBrush="{StaticResource Retro.DarkShadow}" BorderThickness="1,1,0,0">
                    <Border x:Name="Field" BorderBrush="{StaticResource Retro.Light}" BorderThickness="0,0,1,1"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="2,1" VerticalAlignment="Center" />
                    </Border>
                </Border>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Field" Property="Background" Value="{StaticResource Retro.Face}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Retro.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="{StaticResource Retro.Window}" />
        <Setter Property="Foreground" Value="{StaticResource Retro.Text}" />
        <Setter Property="MinHeight" Value="21" />
        <Setter Property="SelectionBrush" Value="{StaticResource Retro.Selection}" />
        <Setter Property="CaretBrush" Value="{StaticResource Retro.Text}" />
        <Setter Property="Template" Value="{StaticResource Retro.SunkenField}" />
    </Style>

    <!-- La caja de atajos hereda de TextBox: necesita su propio estilo -->
    <Style TargetType="ui:HotkeyBox" BasedOn="{StaticResource {x:Type TextBox}}" />

    <!-- Casilla: cuadro blanco hundido de 13 px con la marca clásica -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Retro.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Retro.Text}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border Width="13" Height="13" BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="1,1,0,0" VerticalAlignment="Center">
                            <Border BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="0,0,1,1">
                                <Border BorderBrush="{StaticResource Retro.DarkShadow}" BorderThickness="1,1,0,0">
                                    <Border x:Name="Box" BorderBrush="{StaticResource Retro.Light}" BorderThickness="0,0,1,1"
                                            Background="{StaticResource Retro.Window}">
                                        <Path x:Name="Check" Visibility="Collapsed" Fill="{StaticResource Retro.Text}" Margin="1"
                                              Data="M0,2 L2,4 L6,0 L6,2 L2,6 L0,4 Z" />
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                        <Border x:Name="Label" Margin="5,0,0,0" Padding="1,0" BorderBrush="{StaticResource Retro.Text}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Retro.Face}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Label" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Retro.Shadow}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Retro.Face}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Marco de grupo grabado (línea gris + blanca) con el título encima -->
    <Style TargetType="GroupBox">
        <Setter Property="FontFamily" Value="{StaticResource Retro.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Retro.Text}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Línea grabada: gris y blanca desplazadas 1 px -->
                        <Border Grid.RowSpan="2" Margin="0,6,1,1" BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="1" />
                        <Border Grid.RowSpan="2" Margin="1,7,0,0" BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="1" />
                        <Border HorizontalAlignment="Left" Margin="7,0,0,0" Padding="2,0" Background="{StaticResource Retro.Face}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de desplazamiento clásica (botones con flecha, trama de puntos, cursor en relieve) -->
    <Style x:Key="Retro.ScrollArrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="O1" BorderBrush="{StaticResource Retro.Light}" BorderThickness="1,1,0,0">
                        <Border x:Name="O2" BorderBrush="{StaticResource Retro.DarkShadow}" BorderThickness="0,0,1,1">
                            <Border x:Name="I1" BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="1,1,0,0">
                                <Border x:Name="I2" BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="0,0,1,1"
                                        Background="{StaticResource Retro.Face}">
                                    <Path Fill="{StaticResource Retro.Text}" Data="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="O1" Property="BorderBrush" Value="{StaticResource Retro.Shadow}" />
                            <Setter TargetName="O2" Property="BorderBrush" Value="{StaticResource Retro.Shadow}" />
                            <Setter TargetName="I1" Property="BorderBrush" Value="{StaticResource Retro.Face}" />
                            <Setter TargetName="I2" Property="BorderBrush" Value="{StaticResource Retro.Face}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Retro.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Retro.RaisedThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border BorderBrush="{StaticResource Retro.Light}" BorderThickness="1,1,0,0">
                        <Border BorderBrush="{StaticResource Retro.DarkShadow}" BorderThickness="0,0,1,1">
                            <Border BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="1,1,0,0">
                                <Border BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="0,0,1,1"
                                        Background="{StaticResource Retro.Face}" />
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="16" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{StaticResource Retro.Dither}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                        </Grid.RowDefinitions>
                        <RepeatButton Style="{StaticResource Retro.ScrollArrow}" Command="ScrollBar.LineUpCommand"
                                      Content="M0,4 L3.5,0 L7,4 Z" />
                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Retro.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Retro.RaisedThumb}" MinHeight="8" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Retro.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <RepeatButton Grid.Row="2" Style="{StaticResource Retro.ScrollArrow}" Command="ScrollBar.LineDownCommand"
                                      Content="M0,0 L7,0 L3.5,4 Z" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Horizontal: mismas piezas giradas -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{StaticResource Retro.Dither}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Retro.ScrollArrow}" Command="ScrollBar.LineLeftCommand"
                                              Content="M4,0 L0,3.5 L4,7 Z" />
                                <Track x:Name="PART_Track" Grid.Column="1">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Retro.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Retro.RaisedThumb}" MinWidth="8" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Retro.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Retro.ScrollArrow}" Command="ScrollBar.LineRightCommand"
                                              Content="M0,0 L4,3.5 L0,7 Z" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Lista desplegable: campo blanco hundido + botón con flecha; lista con selección azul marino -->
    <Style x:Key="Retro.ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="O1" BorderBrush="{StaticResource Retro.Light}" BorderThickness="1,1,0,0" Width="16">
                        <Border x:Name="O2" BorderBrush="{StaticResource Retro.DarkShadow}" BorderThickness="0,0,1,1">
                            <Border x:Name="I1" BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="1,1,0,0">
                                <Border x:Name="I2" BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="0,0,1,1"
                                        Background="{StaticResource Retro.Face}">
                                    <Path Fill="{StaticResource Retro.Text}" Data="M0,0 L7,0 L3.5,4 Z" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="O1" Property="BorderBrush" Value="{StaticResource Retro.Shadow}" />
                            <Setter TargetName="O2" Property="BorderBrush" Value="{StaticResource Retro.Shadow}" />
                            <Setter TargetName="I1" Property="BorderBrush" Value="{StaticResource Retro.Face}" />
                            <Setter TargetName="I2" Property="BorderBrush" Value="{StaticResource Retro.Face}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Retro.ComboClickArea" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Retro.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Retro.Text}" />
        <Setter Property="MinHeight" Value="21" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="1,1,0,0">
                            <Border BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="0,0,1,1">
                                <Border BorderBrush="{StaticResource Retro.DarkShadow}" BorderThickness="1,1,0,0">
                                    <Border x:Name="Field" BorderBrush="{StaticResource Retro.Light}" BorderThickness="0,0,1,1"
                                            Background="{StaticResource Retro.Window}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="SelectionBox" Margin="1" Padding="2,0">
                                                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" VerticalAlignment="Center"
                                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                            </Border>
                                            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1,0" VerticalAlignment="Center"
                                                     IsReadOnly="{TemplateBinding IsReadOnly}" Background="Transparent">
                                                <TextBox.Template>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost" />
                                                    </ControlTemplate>
                                                </TextBox.Template>
                                            </TextBox>
                                            <ToggleButton x:Name="ClickArea" Style="{StaticResource Retro.ComboClickArea}"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <ToggleButton Grid.Column="1" Style="{StaticResource Retro.ComboToggle}"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </Grid>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="False" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource Retro.Window}" BorderBrush="{StaticResource Retro.Text}" BorderThickness="1">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectionBox" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="ClickArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                <Condition Property="IsEditable" Value="False" />
                                <Condition Property="IsDropDownOpen" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectionBox" Property="Background" Value="{StaticResource Retro.Selection}" />
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{StaticResource Retro.OnPrimary}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Background" Value="{StaticResource Retro.Face}" />
                            <Setter Property="Foreground" Value="{StaticResource Retro.Shadow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Retro.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="3,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter x:Name="Text" TextElement.Foreground="{StaticResource Retro.Text}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Retro.Selection}" />
                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource Retro.OnPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Control deslizante: surco hundido y cursor en relieve -->
    <Style TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="4" VerticalAlignment="Center" Margin="5,0"
                                BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="1,1,0,0">
                            <Border BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="0,0,1,1">
                                <Border BorderBrush="{StaticResource Retro.DarkShadow}" BorderThickness="1,1,0,0"
                                        Background="{StaticResource Retro.Light}" />
                            </Border>
                        </Border>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Retro.ScrollPage}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Retro.RaisedThumb}" Width="11" Height="21" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Retro.ScrollPage}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lista: campo hundido con selección índigo (editor de clips) -->
    <Style TargetType="ListBox">
        <Setter Property="FontFamily" Value="{StaticResource Retro.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Retro.Text}" />
        <Setter Property="Background" Value="{StaticResource Retro.Window}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="1,1,0,0">
                        <Border BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="0,0,1,1">
                            <Border BorderBrush="{StaticResource Retro.DarkShadow}" BorderThickness="1,1,0,0">
                                <Border BorderBrush="{StaticResource Retro.Light}" BorderThickness="0,0,1,1"
                                        Background="{TemplateBinding Background}">
                                    <ScrollViewer Focusable="False" Padding="1">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Retro.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter x:Name="Text" TextElement.Foreground="{StaticResource Retro.Text}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Retro.Selection}" />
                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource Retro.OnPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de progreso clásica: bloques índigo en un surco hundido -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource Retro.Primary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border BorderBrush="{StaticResource Retro.Shadow}" BorderThickness="1,1,0,0">
                        <Border BorderBrush="{StaticResource Retro.Highlight}" BorderThickness="0,0,1,1"
                                Background="{StaticResource Retro.Face}" Padding="2">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <!-- Bloques de 8 px con 2 px de separación, como en Windows 95 -->
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute" Stretch="None">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="{StaticResource Retro.Primary}" Geometry="M0,0 H8 V10 H0 Z" />
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel hundido (barra de estado) -->
    <Style x:Key="Retro.StatusPanel" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Retro.Shadow}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
</ResourceDictionary>
