<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Proyecciones WinRT del SDK 22621 para poder usar (protegido con ApiInformation)
         IsBorderRequired en Windows 11; el mínimo real de ejecución es Windows 10 1903. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <!-- Solo para NotifyIcon (bandeja); forma parte del Windows Desktop Runtime. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>ReplayClip</RootNamespace>
    <AssemblyName>ReplayClip</AssemblyName>

    <!-- Bajo consumo: GC de estación no concurrente (menos hilos y memoria). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Precompilación al publicar: menos CPU de JIT al arrancar. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms y WPF comparten nombres (Application, MessageBox...): quitamos los using implícitos de WinForms. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF excluye System.IO de los using implícitos (choque con Shapes.Path); lo añadimos a mano. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReplayClip.Tests" />
    <InternalsVisibleTo Include="ReplayClip.SmokeTest" />
  </ItemGroup>

</Project>
